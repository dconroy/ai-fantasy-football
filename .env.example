# Neon pooled URL for application traffic and direct URL for migrations.
DATABASE_URL="postgresql://user:password@pooler.example.neon.tech/database?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@example.neon.tech/database?sslmode=require"

# Public HTTPS URL for OAuth callbacks.
APP_URL="https://draft.example.com"

# Create an app at https://developer.yahoo.com/apps/
YAHOO_CLIENT_ID="replace-with-yahoo-client-id"
YAHOO_CLIENT_SECRET="replace-with-yahoo-client-secret"
YAHOO_REDIRECT_URI="https://draft.example.com/api/yahoo/callback"
YAHOO_LEAGUE_KEY="replace-with-2026-league-key"
# Leave blank until Yahoo grants a Fantasy Sports scope to the application.
YAHOO_OAUTH_SCOPE=""

# Generate with: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY="replace-with-32-byte-base64-key"

# Optional themed password gate for the private dashboard.
APP_ACCESS_PASSWORD="replace-with-a-long-random-password"

# Read-only sync controls
YAHOO_SYNC_ENABLED="false"
YAHOO_POLL_INTERVAL_MS="15000"

# Future selection behavior is deliberately unavailable and disabled.
AUTO_SELECTION_ENABLED="false"
AUTO_SELECTION_MIN_CONFIDENCE="0.90"

# Public Boris Chen PPR file; override only with a permitted source.
CHEN_PPR_CSV_URL="https://s3-us-west-1.amazonaws.com/fftiers/out/weekly-ALL-PPR.csv"
